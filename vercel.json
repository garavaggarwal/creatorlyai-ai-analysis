{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/analyse",
      "dest": "/api/analyse.js"
    },
    {
      "src": "/api/chatbot",
      "dest": "/api/chatbot.js"
    },
    {
      "src": "/login",
      "dest": "/public/login.html"
    },
    {
      "src": "/analyser",
      "dest": "/public/index.html"
    },
    {
      "src": "/ai-analyser",
      "dest": "/public/index.html"
    },
    {
      "src": "/profile",
      "dest": "/public/profile.html"
    },
    {
      "src": "/style.css",
      "dest": "/public/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/public/app.js"
    },
    {
      "src": "/chatbot.js",
      "dest": "/public/chatbot.js"
    },
    {
      "src": "/login.css",
      "dest": "/public/login.css"
    },
    {
      "src": "/login.js",
      "dest": "/public/login.js"
    },
    {
      "src": "/landing.css",
      "dest": "/public/landing.css"
    },
    {
      "src": "/landing.js",
      "dest": "/public/landing.js"
    },
    {
      "src": "/auth.js",
      "dest": "/public/auth.js"
    },
    {
      "src": "/prompt-generator",
      "dest": "/public/prompt-generator.html"
    },
    {
      "src": "/profile.css",
      "dest": "/public/profile.css"
    },
    {
      "src": "/profile.js",
      "dest": "/public/profile.js"
    },
    {
      "src": "/",
      "dest": "/public/landing.html"
    }
  ]
}
